# =============================================================================
# Copia este archivo a .env y llena lo que necesites:  cp .env.example .env
#
# .env está en .gitignore. Nunca pongas credenciales reales AQUÍ: este archivo
# sí se versiona. Todos los valores de abajo son de ejemplo.
# =============================================================================

# --- Proveedor de modelo -----------------------------------------------------
# mock | azure | openai | compatible
# mock no necesita credenciales: es el que usan los tests y CI.
LLM_PROVIDER=mock

# Modelo por defecto para openai y compatible. Azure usa el deployment.
LLM_MODEL=gpt-5-mini

# Esfuerzo de razonamiento: minimal | low | medium | high
# Déjalo VACÍO (REASONING_EFFORT=) si el modelo no es de razonamiento:
# gpt-4o y familia devuelven 400 si les llega el bloque `reasoning`.
REASONING_EFFORT=minimal

# --- Azure OpenAI (LLM_PROVIDER=azure) ---------------------------------------
# El endpoint que da el portal de Foundry, con el sufijo /openai/v1.
# También se acepta sin el sufijo: el código lo agrega.
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=pon-aqui-tu-clave-de-azure
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# La v1 GA NO pide api-version: déjala vacía. Sólo si el recurso llegara a
# responder 400 pidiéndola, ponle: preview
AZURE_OPENAI_API_VERSION=

# --- OpenAI (LLM_PROVIDER=openai) --------------------------------------------
OPENAI_API_KEY=sk-pon-aqui-tu-clave

# --- Cualquier API compatible (LLM_PROVIDER=compatible) ----------------------
# Base URL que exponga /responses. Sin barra final.
LLM_BASE_URL=https://tu-proveedor.example.com/v1
LLM_API_KEY=pon-aqui-tu-clave

# --- Este agente -------------------------------------------------------------
# Bearer token de /v1/responses. Genera uno con: openssl rand -hex 24
# Si lo dejas VACÍO el endpoint queda ABIERTO: sólo para desarrollo local.
AGENT_API_KEY=pon-aqui-un-token-largo-y-aleatorio

# URL pública del endpoint. La tarjeta de agente la publica como suya.
PUBLIC_BASE_URL=http://localhost:8080/v1

# --- Demo pública del sitio (POST /api/chat) ---------------------------------
# false apaga la demo y devuelve 404.
PUBLIC_DEMO=true
# Tope de consumo por IP: una página web no puede guardar una credencial.
DEMO_RATE_LIMIT=12
DEMO_RATE_WINDOW_S=3600

# --- Límites del bucle -------------------------------------------------------
# Vueltas máximas de herramienta antes de rendirse.
MAX_TOOL_ITERATIONS=4
# Presupuesto de entrada en caracteres. El historial viejo se corta antes que
# las instructions, para que los guardarraíles nunca se caigan por longitud.
MAX_INPUT_CHARS=24000
REQUEST_TIMEOUT_S=60

# --- Perfil ------------------------------------------------------------------
# Fuente única de verdad. Ruta absoluta o relativa a la raíz del repo.
PROFILE_PATH=data/perfil.yaml

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO

# =============================================================================
# Sólo para correr la batería de evaluación (evals/run_evals.py).
# No las necesita el servidor.
# =============================================================================
# Endpoint contra el que se evalúa. En CI viene del secret EVAL_BASE_URL.
EVAL_BASE_URL=http://localhost:8080/v1
# Si no la defines, cae a AGENT_API_KEY.
EVAL_API_KEY=
# Juez LLM (opcional). Sin esta clave el juez se omite y sólo corren los
# asserts deterministas. Cae a OPENAI_API_KEY si no está.
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini
